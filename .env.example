# scufris-server environment configuration
# Copy this file to .env and adjust values as needed.
# All variables are optional — defaults are shown below.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Interface scufris-server binds to.
# Use 0.0.0.0 to expose on all interfaces (not recommended for production).
# SCUFRIS_BIND=127.0.0.1

# TCP port scufris-server listens on. Valid range: 1–65535.
# SCUFRIS_PORT=7080

# ---------------------------------------------------------------------------
# OpenCode daemon
# ---------------------------------------------------------------------------

# Base URL of the opencode serve daemon.
# OPENCODE_URL=http://127.0.0.1:4096

# Bearer token expected by opencode.
# Optional when OPENCODE_URL is loopback (127.0.0.1, ::1, localhost) —
# a warning is emitted at startup if unset for any non-loopback URL.
# OPENCODE_SERVER_PASSWORD=

# Override the model used by the opencode daemon.
# Format: "providerID/modelID" (e.g. "ollama/qwen3:30b-a3b").
# "modelID" alone defaults to the "ollama" provider.
# When unset, the model is probed from the daemon via GET /provider.
# OPENCODE_MODEL=

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------

# Directory for the SQLite database and other persistent state.
# Honors $XDG_STATE_HOME when set; otherwise defaults to ~/.local/state/scufris.
# SCUFRIS_STATE_DIR=/home/user/.local/state/scufris

# ---------------------------------------------------------------------------
# Identity (#12)
# ---------------------------------------------------------------------------

# Explicit path to config.toml.
# When unset, resolves $XDG_CONFIG_HOME/scufris/config.toml
# (falling back to ~/.config/scufris/config.toml).
# A non-existent path is not an error — only the default user (id=1) resolves.
# SCUFRIS_CONFIG=/home/user/.config/scufris/config.toml

# Server-side user identity override.
# When set, every resolve_user call short-circuits to this user_id,
# bypassing the TOML lookup and skipping surface_bindings inserts.
# Useful for single-user dev/test deployments. Must be >= 1.
# SCUFRIS_USER_ID=1

